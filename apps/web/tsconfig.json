{
  "extends": "@pfa/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client", "node"],
    "verbatimModuleSyntax": false,
    "allowJs": true
