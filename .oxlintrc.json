{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", ".changeset/**"],
  "overrides": [
    {
      "files": ["packages/core/**", "packages/protocol/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "Intl", "message": "No Intl in core: use date-fns and the Dinero formatter." },
          { "name": "window", "message": "core is platform-free." },
          { "name": "document", "message": "core is platform-free." },
          { "name": "Buffer", "message": "core is platform-free." }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "react",
              "react-native",
              "react-dom",
              "node:*",
              "@pfa/web",
              "@pfa/mobile",
              "@pfa/desktop",
              "@pfa/relay"
            ]
          }
        ]
      }
    }
  ]
}
