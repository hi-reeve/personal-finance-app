{
  "name": "@pfa/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node scripts/precache.ts dist/client",
    "preview": "vp preview",
    "typecheck": "pnpm paraglide && tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@inlang/paraglide-js": "^2.29.0",
    "@pfa/core": "workspace:*",
    "@pfa/protocol": "workspace:*",
    "@pfa/tokens": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@inlang/plugin-message-format": "^4.5.4",
    "@pfa/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
